+const char *ToString(EventRole role)
+{
+    switch (role)
+    {
+    case EventRole::Source:
+        return "source";
+    case EventRole::Target:
+        return "target";
+    }
+    return "?";
+}
+
+const char *ToString(EventPhase phase)
+{
+    switch (phase)
+    {
+    case EventPhase::HoRequiredSent:
+        return "HO_REQUIRED_SENT";
+    case EventPhase::HoPrepFailure:
+        return "HO_PREP_FAILURE";
+    case EventPhase::HoCommandReceived:
+        return "HO_COMMAND_RECEIVED";
+    case EventPhase::RrcRecfgSent:
+        return "RRC_RECFG_SENT";
+    case EventPhase::UeCtxReleaseReceived:
+        return "UE_CTX_RELEASE_RECEIVED";
+    case EventPhase::HoRequestReceived:
+        return "HO_REQUEST_RECEIVED";
+    case EventPhase::HoAckSent:
+        return "HO_ACK_SENT";
+    case EventPhase::HoFailureSent:
+        return "HO_FAILURE_SENT";
+    case EventPhase::RrcRecfgCompleteReceived:
+        return "RRC_RECFG_COMPLETE_RECEIVED";
+    case EventPhase::HoNotifySent:
+        return "HO_NOTIFY_SENT";
+    }
+    return "?";
+}
+
+static std::string EscapeJson(const std::string &value)
+{
+    std::string out;
+    out.reserve(value.size() + 2);
+    for (char c : value)
+    {
+        switch (c)
+        {
+        case '"':
+            out += "\\\"";
+            break;
+        case '\\':
+            out += "\\\\";
+            break;
+        case '\n':
+            out += "\\n";
+            break;
+        case '\r':
+            out += "\\r";
+            break;
+        case '\t':
+            out += "\\t";
+            break;
+        default:
+            out += c;
+            break;
+        }
+    }
+    return out;
+}
+
+static int64_t CurrentMonotonicMillis()
+{
+    auto now = std::chrono::steady_clock::now().time_since_epoch();
+    return std::chrono::duration_cast<std::chrono::milliseconds>(now).count();
+}
+
+std::string SerializeEvent(const HoEvent &event)
+{
+    std::stringstream ss;
+    ss << "{\"schema\":\"ueransim-ho-event/1\""
+       << ",\"ho_id\":" << event.hoId << ",\"wall_ms\":" << event.wallMs << ",\"mono_ms\":" << event.monoMs
+       << ",\"node\":\"" << EscapeJson(event.node) << "\""
+       << ",\"role\":\"" << ToString(event.role) << "\""
+       << ",\"phase\":\"" << ToString(event.phase) << "\""
+       << ",\"ue\":{\"id\":" << event.ueId << ",\"sti\":" << event.sti << ",\"ran_ngap_id\":" << event.ranNgapId
+       << ",\"amf_ue_ngap_id\":" << event.amfUeNgapId << ",\"nci\":" << event.nci << "}"
+       << ",\"sessions\":[";
+    for (size_t i = 0; i < event.sessions.size(); i++)
+    {
+        if (i != 0)
+            ss << ",";
+        ss << event.sessions[i];
+    }
+    ss << "]}";
+    return ss.str();
+}
+
+EventLog &EventLog::Instance()
+{
+    static EventLog instance;
+    return instance;
+}
+
+void EventLog::initialize(const std::string &nodeName)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+
+    m_nodeName = nodeName;
+    m_path = "logs/" + nodeName + ".ho-events.jsonl";
+    m_initialized = true;
+    m_failed = false;
+
+    std::error_code ec;
+    fs::create_directories("logs", ec);
+}
+
+void EventLog::emit(const HoEvent &event)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+
+    if (!m_initialized)
+    {
+        std::fprintf(stderr, "[ho-events] event log is not initialized, event dropped\n");
+        m_failed = true;
+        return;
+    }
+    if (m_failed)
+        return;
+
+    HoEvent e = event;
+    if (e.node.empty())
+        e.node = m_nodeName;
+    if (e.wallMs == 0)
+        e.wallMs = utils::CurrentTimeMillis();
+    if (e.monoMs == 0)
+        e.monoMs = CurrentMonotonicMillis();
+
+    std::ofstream file(m_path, std::ios::app);
+    if (!file.is_open())
+    {
+        std::fprintf(stderr, "[ho-events] cannot open %s, further events are dropped\n", m_path.c_str());
+        m_failed = true;
+        return;
+    }
+
+    file << SerializeEvent(e) << "\n";
+    file.flush();
+}
+
+} // namespace ho
