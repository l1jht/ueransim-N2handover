+//
+
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// Service-agnostic machine-readable handover event log (JSON Lines).
+//
+// Each gNB process appends its handover-related events to
+//   logs/<node-name>.ho-events.jsonl
+// relative to the process working directory. The log is intentionally independent
+// of any upper-layer service (no IMS/SIP/RTP knowledge).
+//
+// Source and target events of the same handover share a hoId: it is generated by
+// the source gNB and carried to the target inside the simulation-defined
+// Source-To-Target transparent container payload (see ho.hpp).
+namespace ho
+{
+
+enum class EventRole
+{
+    Source,
+    Target,
+};
+
+enum class EventPhase
+{
+    HoRequiredSent,
+    HoPrepFailure,
+    HoCommandReceived,
+    RrcRecfgSent,
+    UeCtxReleaseReceived,
+    HoRequestReceived,
+    HoAckSent,
+    HoFailureSent,
+    RrcRecfgCompleteReceived,
+    HoNotifySent,
+};
+
+struct HoEvent
+{
+    uint64_t hoId{};
+    int64_t wallMs{};
+    int64_t monoMs{};
+    std::string node{};
+    EventRole role{};
+    EventPhase phase{};
+    int ueId{};
+    uint64_t sti{};
+    int64_t ranNgapId{};
+    int64_t amfUeNgapId{};
+    int64_t nci{};
+    std::vector<int> sessions{};
+};
+
+const char *ToString(EventRole role);
+const char *ToString(EventPhase phase);
+
+// Serializes one event as a single JSON object (no trailing newline). Pure function.
+std::string SerializeEvent(const HoEvent &event);
+
+class EventLog
+{
+  public:
+    static EventLog &Instance();
+
+    // Sets the node name and opens logs/<nodeName>.ho-events.jsonl in append mode.
+    // Failures are reported once on stderr and never break the caller.
+    void initialize(const std::string &nodeName);
+
+    void emit(const HoEvent &event);
+
+  private:
+    EventLog() = default;
+    EventLog(const EventLog &) = delete;
+    EventLog &operator=(const EventLog &) = delete;
+
+    std::mutex m_mutex;
+    std::string m_nodeName{};
+    std::string m_path{};
+    bool m_initialized{false};
+    bool m_failed{false};
+};
+
+} // namespace ho
