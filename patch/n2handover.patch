+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include <utils/octet_string.hpp>
+
+// Simulation-defined payloads and helpers for the N2 handover feature.
+//
+// UERANSIM simulates the radio interface internally, therefore the RRC containers that are
+// carried transparently over NGAP (Source-To-Target / Target-To-Source) are filled with the
+// simulation-defined structures below instead of real ASN.1 RRC PDUs. The NGAP envelope,
+// message flow and procedure states remain standard.
+namespace ho
+{
+
+// Simulation container markers (first octet of the payload)
+constexpr uint8_t MARKER_SOURCE_INFO = 0xA1;
+constexpr uint8_t MARKER_COMMAND_INFO = 0xA2;
+
+// Carried in the Source-To-Target Transparent Container (source gNB -> target gNB).
+// Identifies the simulated UE across gNBs (RLS STI: the stable "over-the-air" identity).
+struct SourceInfo
+{
+    uint64_t ueSti{};
+};
+
+// Carried in the Target-To-Source Transparent Container (target gNB -> source gNB) and then
+// forwarded to the UE inside the RRC Reconfiguration (i.e. the simulated handover command).
+struct CommandInfo
+{
+    uint64_t targetNci{}; // 36-bit NR Cell Identity of the target cell
+};
+
+OctetString EncodeSourceInfo(const SourceInfo &info);
+std::optional<SourceInfo> DecodeSourceInfo(const OctetString &data);
+
+OctetString EncodeCommandInfo(const CommandInfo &info);
+std::optional<CommandInfo> DecodeCommandInfo(const OctetString &data);
+
+// Cell ranking used by cell selection: higher signal strength wins, and ties are broken by the
+// lower NCI so that cell selection is deterministic (important for repeatable simulations).
+bool IsBetterCell(int dbmNew, uint64_t nciNew, int dbmRef, uint64_t nciRef);
+
+// Finds the (local) cell id of the cell with the given NCI among the described cells.
+std::optional<int> FindCellByNci(const std::vector<std::pair<int, uint64_t>> &cells, uint64_t nci);
+
+} // namespace ho
