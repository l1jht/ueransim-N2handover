diff --git a/src/gnb/rrc/handover.cpp b/src/gnb/rrc/handover.cpp
new file mode 100644
index 0000000..215db5c
--- /dev/null
+++ b/src/gnb/rrc/handover.cpp
@@ -0,0 +1,66 @@
+//
+// This file is a part of UERANSIM project.
+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+// gNB side RRC handlers for the N2 handover simulation.
+//
+// On the source gNB the handover command received over NGAP is forwarded to the UE inside an
+// RRC Reconfiguration message. On the target gNB the RRC Reconfiguration Complete message sent
+// by the UE completes the radio part of the handover and triggers the Handover Notify.
+
+#include "task.hpp"
+
+#include <gnb/ngap/task.hpp>
+#include <lib/rrc/encode.hpp>
+
+#include <asn/rrc/ASN_RRC_DL-DCCH-Message.h>
+#include <asn/rrc/ASN_RRC_RRCReconfiguration-IEs.h>
+#include <asn/rrc/ASN_RRC_RRCReconfiguration.h>
+
+namespace nr::gnb
+{
+
+void GnbRrcTask::handleHandoverCommand(int ueId, const OctetString &rrcContainer)
+{
+    auto *pdu = asn::New<ASN_RRC_DL_DCCH_Message>();
+    pdu->message.present = ASN_RRC_DL_DCCH_MessageType_PR_c1;
+    pdu->message.choice.c1 = asn::NewFor(pdu->message.choice.c1);
+    pdu->message.choice.c1->present = ASN_RRC_DL_DCCH_MessageType__c1_PR_rrcReconfiguration;
+
+    auto &rrc = pdu->message.choice.c1->choice.rrcReconfiguration = asn::New<ASN_RRC_RRCReconfiguration>();
+    rrc->rrc_TransactionIdentifier = getNextTid();
+    rrc->criticalExtensions.present = ASN_RRC_RRCReconfiguration__criticalExtensions_PR_rrcReconfiguration;
+    rrc->criticalExtensions.choice.rrcReconfiguration = asn::New<ASN_RRC_RRCReconfiguration_IEs>();
+
+    // UERANSIM simulates the radio interface: the handover command payload generated by the target
+    // gNB (from the target-to-source transparent container) is carried in the otherwise unused
+    // secondaryCellGroup field of the RRC Reconfiguration.
+    auto &ies = rrc->criticalExtensions.choice.rrcReconfiguration;
+    ies->secondaryCellGroup = asn::New<OCTET_STRING_t>();
+    asn::SetOctetString(*ies->secondaryCellGroup, rrcContainer);
+
+    m_logger->info("N2 handover: sending RRC Reconfiguration (handover command) to UE[%d]", ueId);
+    sendRrcMessage(ueId, pdu);
+    asn::Free(asn_DEF_ASN_RRC_DL_DCCH_Message, pdu);
+}
+
+void GnbRrcTask::receiveRrcHandoverConfirm(int ueId, const ASN_RRC_RRCReconfigurationComplete &msg)
+{
+    // The UE arrives on this gNB already in RRC_CONNECTED state, so there is no RRC Setup
+    // procedure: the UE context is created here if it does not exist yet.
+    if (tryFindUe(ueId) == nullptr)
+        createUe(ueId);
+
+    auto w = std::make_unique<NmGnbRrcToNgap>(NmGnbRrcToNgap::HANDOVER_CONFIRM);
+    w->ueId = ueId;
+    w->sti = m_ueSti.count(ueId) != 0 ? m_ueSti[ueId] : 0;
+    m_base->ngapTask->push(std::move(w));
+
+    m_logger->info("N2 handover: handover confirm (RRC Reconfiguration Complete) received from UE[%d]", ueId);
+}
+
+} // namespace nr::gnb
