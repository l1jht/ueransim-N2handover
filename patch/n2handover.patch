new file mode 100644
index 0000000..8fabeb1
--- /dev/null
+++ b/src/lib/ho/ho.cpp
@@ -0,0 +1,82 @@
+//
+// This file is a part of UERANSIM project.
+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+#include "ho.hpp"
+
+namespace ho
+{
+
+static OctetString EncodeU64WithMarker(uint8_t marker, uint64_t value)
+{
+    OctetString out;
+    out.appendOctet(marker);
+    out.appendOctet8(value);
+    return out;
+}
+
+OctetString EncodeSourceInfo(const SourceInfo &info)
+{
+    return EncodeU64WithMarker(MARKER_SOURCE_INFO, info.ueSti);
+}
+
+std::optional<SourceInfo> DecodeSourceInfo(const OctetString &data)
+{
+    if (data.length() != 9 || data.getI(0) != MARKER_SOURCE_INFO)
+        return std::nullopt;
+
+    SourceInfo info{};
+    info.ueSti = data.get8UL(1);
+    return info;
+}
+
+OctetString EncodeCommandInfo(const CommandInfo &info)
+{
+    if (info.targetNci > 0xFFFFFFFFFULL)
+        return OctetString{};
+
+    OctetString out;
+    out.appendOctet(MARKER_COMMAND_INFO);
+    for (int i = 0; i < 5; i++)
+        out.appendOctet(static_cast<uint8_t>((info.targetNci >> (8 * (4 - i))) & 0xFF));
+    return out;
+}
+
+std::optional<CommandInfo> DecodeCommandInfo(const OctetString &data)
+{
+    if (data.length() != 6 || data.getI(0) != MARKER_COMMAND_INFO)
+        return std::nullopt;
+
+    // The NR Cell Identity is 36 bits, so the upper 4 bits of the first octet must be zero
+    if (data.getI(1) > 0x0F)
+        return std::nullopt;
+
+    uint64_t nci = 0;
+    for (int i = 0; i < 5; i++)
+        nci = (nci << 8) | static_cast<uint64_t>(data.getI(1 + i));
+
+    CommandInfo info{};
+    info.targetNci = nci;
+    return info;
+}
+
+bool IsBetterCell(int dbmNew, uint64_t nciNew, int dbmRef, uint64_t nciRef)
+{
+    if (dbmNew != dbmRef)
+        return dbmNew > dbmRef;
+    return nciNew < nciRef;
+}
+
+std::optional<int> FindCellByNci(const std::vector<std::pair<int, uint64_t>> &cells, uint64_t nci)
+{
+    for (auto &cell : cells)
+        if (cell.second == nci)
+            return cell.first;
+    return std::nullopt;
+}
+
+} // namespace ho
