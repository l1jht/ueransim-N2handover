diff --git a/tests/handover/ho_tests.cpp b/tests/handover/ho_tests.cpp
new file mode 100644
index 0000000..638a731
--- /dev/null
+++ b/tests/handover/ho_tests.cpp
@@ -0,0 +1,110 @@
+// Plain-assert unit tests for the N2 handover pure functions.
+//
+// Covers the simulation container codec (lib/ho) and the deterministic cell ranking used by
+// cell selection. No external test framework is used.
+
+#include <cstdint>
+#include <cstdio>
+#include <utility>
+#include <vector>
+
+#include <lib/ho/ho.hpp>
+
+static int g_failures = 0;
+
+#define CHECK(cond, name)                                                                                              \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(cond))                                                                                                   \
+        {                                                                                                              \
+            std::printf("[FAIL] %s\n", name);                                                                          \
+            g_failures++;                                                                                              \
+        }                                                                                                              \
+        else                                                                                                           \
+        {                                                                                                              \
+            std::printf("[ OK ] %s\n", name);                                                                          \
+        }                                                                                                              \
+    } while (0)
+
+int main()
+{
+    using namespace ho;
+
+    // ---------- SourceInfo codec ----------
+    {
+        SourceInfo info{};
+        info.ueSti = 0x1122334455667788ULL;
+        auto encoded = EncodeSourceInfo(info);
+        CHECK(encoded.length() == 9, "source info encoded length is 9");
+
+        auto decoded = DecodeSourceInfo(encoded);
+        CHECK(decoded.has_value() && decoded->ueSti == info.ueSti, "source info round trip");
+    }
+    {
+        OctetString wrongMarker;
+        wrongMarker.appendOctet(MARKER_COMMAND_INFO);
+        wrongMarker.appendOctet8(uint64_t{1});
+        CHECK(!DecodeSourceInfo(wrongMarker).has_value(), "source info rejects wrong marker");
+
+        OctetString truncated;
+        truncated.appendOctet(MARKER_SOURCE_INFO);
+        CHECK(!DecodeSourceInfo(truncated).has_value(), "source info rejects truncated input");
+
+        CHECK(!DecodeSourceInfo(OctetString{}).has_value(), "source info rejects empty input");
+    }
+
+    // ---------- CommandInfo codec ----------
+    {
+        const uint64_t ncis[] = {0ULL, 1ULL, 0x10ULL, 0xABCDEF123ULL, 0xFFFFFFFFFULL};
+        bool allOk = true;
+        for (uint64_t nci : ncis)
+        {
+            CommandInfo info{};
+            info.targetNci = nci;
+            auto encoded = EncodeCommandInfo(info);
+            auto decoded = DecodeCommandInfo(encoded);
+            allOk = allOk && decoded.has_value() && decoded->targetNci == nci;
+        }
+        CHECK(allOk, "command info round trip for boundary NCIs");
+    }
+    {
+        CommandInfo overflow{};
+        overflow.targetNci = 0x1000000000ULL; // 37 bits
+        CHECK(EncodeCommandInfo(overflow).length() == 0, "command info rejects NCI larger than 36 bits on encode");
+    }
+    {
+        OctetString badRange;
+        badRange.appendOctet(MARKER_COMMAND_INFO);
+        badRange.appendOctet(0x10); // upper 4 bits must be zero for a 36-bit NCI
+        badRange.appendOctet(0);
+        badRange.appendOctet(0);
+        badRange.appendOctet(0);
+        badRange.appendOctet(0);
+        CHECK(!DecodeCommandInfo(badRange).has_value(), "command info enforces the 36-bit NCI range on decode");
+    }
+
+    // ---------- Deterministic cell ranking ----------
+    {
+        CHECK(IsBetterCell(-50, 0x20, -60, 0x10), "stronger signal wins regardless of NCI");
+        CHECK(!IsBetterCell(-60, 0x10, -50, 0x20), "weaker signal loses regardless of NCI");
+        CHECK(IsBetterCell(-50, 0x10, -50, 0x20), "equal signal prefers the lower NCI");
+        CHECK(!IsBetterCell(-50, 0x20, -50, 0x10), "equal signal rejects the higher NCI");
+    }
+
+    // ---------- Target cell resolution ----------
+    {
+        std::vector<std::pair<int, uint64_t>> cells{{1, 0x10}, {2, 0x20}, {3, 0x30}};
+        auto found = FindCellByNci(cells, 0x20);
+        CHECK(found.has_value() && found.value() == 2, "target cell resolved by NCI");
+        CHECK(!FindCellByNci(cells, 0x40).has_value(), "unknown NCI is not resolved");
+    }
+
+    if (g_failures == 0)
+    {
+        std::printf("All N2 handover tests passed.\n");
+        return 0;
+    }
+
+    std::printf("%d N2 handover test(s) failed.\n", g_failures);
+    return 1;
+}
