+// The target NCI is derived from the target gNB ID using the same convention as the NG Setup
+// (36-bit NCI = gNB ID (idLength bits) followed by the cell ID part, which is 0 in this simulation).
+static uint64_t NciFromGnbId(uint32_t gnbId, int idLength)
+{
+    if (idLength < 22 || idLength > 32)
+        return 0;
+    return static_cast<uint64_t>(gnbId) << (36 - idLength);
+}
+
+static OctetString EncodeHandoverRequiredTransfer()
+{
+    auto *transfer = asn::New<ASN_NGAP_HandoverRequiredTransfer>();
+    // directForwardingPathAvailability is intentionally absent: gNB-to-gNB data forwarding is not
+    // implemented in this simulation (see the user plane notes in the delivery documentation).
+    OctetString encoded = ngap_encode::EncodeS(asn_DEF_ASN_NGAP_HandoverRequiredTransfer, transfer);
+    asn::Free(asn_DEF_ASN_NGAP_HandoverRequiredTransfer, transfer);
+    return encoded;
+}
+
+static void FillPduSessionResourceFromTransfer(ASN_NGAP_PDUSessionResourceSetupRequestTransfer *transfer,
+                                               PduSessionResource *resource)
+{
+    auto *ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_PDUSessionAggregateMaximumBitRate);
+    if (ie != nullptr)
+    {
+        resource->sessionAmbr.dlAmbr =
+            asn::GetUnsigned64(ie->PDUSessionAggregateMaximumBitRate.pDUSessionAggregateMaximumBitRateDL) / 8ull;
+        resource->sessionAmbr.ulAmbr =
+            asn::GetUnsigned64(ie->PDUSessionAggregateMaximumBitRate.pDUSessionAggregateMaximumBitRateUL) / 8ull;
+    }
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_DataForwardingNotPossible);
+    if (ie != nullptr)
+        resource->dataForwardingNotPossible = true;
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_PDUSessionType);
+    if (ie != nullptr)
+        resource->sessionType = ngap_utils::PduSessionTypeFromAsn(ie->PDUSessionType);
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_UL_NGU_UP_TNLInformation);
+    if (ie != nullptr)
+    {
+        resource->upTunnel.teid = (uint32_t)asn::GetOctet4(ie->UPTransportLayerInformation.choice.gTPTunnel->gTP_TEID);
+        resource->upTunnel.address = asn::GetOctetString(ie->UPTransportLayerInformation.choice.gTPTunnel->transportLayerAddress);
+    }
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_QosFlowSetupRequestList);
+    if (ie != nullptr)
+    {
+        auto *ptr = asn::New<ASN_NGAP_QosFlowSetupRequestList>();
+        asn::DeepCopy(asn_DEF_ASN_NGAP_QosFlowSetupRequestList, ie->QosFlowSetupRequestList, ptr);
+        resource->qosFlows = asn::WrapUnique(ptr, asn_DEF_ASN_NGAP_QosFlowSetupRequestList);
+    }
+}
+
+static std::optional<NgapCause> ValidateSessionResource(const PduSessionResource *resource)
+{
+    if (resource->sessionType != PduSessionType::IPv4)
+        return NgapCause::RadioNetwork_unspecified;
+
+    if (resource->upTunnel.address.length() == 0)
+        return NgapCause::Protocol_transfer_syntax_error;
+
+    if (resource->qosFlows == nullptr || resource->qosFlows->list.count == 0)
+        return NgapCause::Protocol_semantic_error;
+
+    return std::nullopt;
+}
+
+static ASN_NGAP_PDUSessionResourceFailedToSetupItemHOAck *CreateUnsuccessfulSessionItem(int psi, NgapCause cause,
+                                                                                        Logger &logger)
+{
+    auto *tr = asn::New<ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer>();
+    ngap_utils::ToCauseAsn_Ref(cause, tr->cause);
+
+    OctetString encodedTr =
+        ngap_encode::EncodeS(asn_DEF_ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer, tr);
+    if (encodedTr.length() == 0)
+    {
+        asn::Free(asn_DEF_ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer, tr);
+        logger.err("HandoverResourceAllocationUnsuccessfulTransfer encoding failed");
+        return nullptr;
+    }
+    asn::Free(asn_DEF_ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer, tr);
+
+    auto *item = asn::New<ASN_NGAP_PDUSessionResourceFailedToSetupItemHOAck>();
+    item->pDUSessionID = static_cast<ASN_NGAP_PDUSessionID_t>(psi);
+    asn::SetOctetString(item->handoverResourceAllocationUnsuccessfulTransfer, encodedTr);
+    return item;
+}
+
+void NgapTask::sendHandoverRequired(int ueId, int gnbTargetId)
+{
+    auto *ue = findUeContext(ueId);
+    if (ue == nullptr)
+        return;
+
+    if (ue->sti == 0)
+    {
+        m_logger->err("N2 handover: UE[%d] has no simulated radio identity yet, cannot start a handover", ueId);
+        return;
+    }
+
+    auto *amf = findAmfContext(ue->associatedAmfId);
+    if (amf == nullptr)
+        return;
+
+    if (amf->state != EAmfState::CONNECTED)
+    {
+        m_logger->err("N2 handover: cannot start a handover, the AMF is not in connected state");
+        return;
+    }
+
+    if (ue->pduSessions.empty())
+        m_logger->warn("N2 handover: UE[%d] has no active PDU session, the handover will carry no session resources", ueId);
+
+    std::vector<ASN_NGAP_HandoverRequiredIEs *> ies;
+
+    // Handover Type
+    auto *ieHandoverType = asn::New<ASN_NGAP_HandoverRequiredIEs>();
+    ieHandoverType->id = ASN_NGAP_ProtocolIE_ID_id_HandoverType;
+    ieHandoverType->criticality = ASN_NGAP_Criticality_reject;
+    ieHandoverType->value.present = ASN_NGAP_HandoverRequiredIEs__value_PR_HandoverType;
+    ieHandoverType->value.choice.HandoverType = ASN_NGAP_HandoverType_intra5gs;
+    ies.push_back(ieHandoverType);
+
+    // Cause
+    auto *ieCause = asn::New<ASN_NGAP_HandoverRequiredIEs>();
+    ieCause->id = ASN_NGAP_ProtocolIE_ID_id_Cause;
+    ieCause->criticality = ASN_NGAP_Criticality_ignore;
+    ieCause->value.present = ASN_NGAP_HandoverRequiredIEs__value_PR_Cause;
+    ngap_utils::ToCauseAsn_Ref(NgapCause::RadioNetwork_handover_desirable_for_radio_reason, ieCause->value.choice.Cause);
+    ies.push_back(ieCause);
+
+    // Target ID: the target RAN node is identified by its global gNB ID and the selected TAI.
+    // The simulation assumes that both gNBs serve the same PLMN and TAC.
+    auto *ieTargetId = asn::New<ASN_NGAP_HandoverRequiredIEs>();
+    ieTargetId->id = ASN_NGAP_ProtocolIE_ID_id_TargetID;
+    ieTargetId->criticality = ASN_NGAP_Criticality_reject;
+    ieTargetId->value.present = ASN_NGAP_HandoverRequiredIEs__value_PR_TargetID;
+    ieTargetId->value.choice.TargetID.present = ASN_NGAP_TargetID_PR_targetRANNodeID;
+
+    auto *targetRanNodeId = asn::New<ASN_NGAP_TargetRANNodeID>();
+    targetRanNodeId->globalRANNodeID.present = ASN_NGAP_GlobalRANNodeID_PR_globalGNB_ID;
+
+    auto *globalGnbId = asn::New<ASN_NGAP_GlobalGNB_ID>();
+    globalGnbId->gNB_ID.present = ASN_NGAP_GNB_ID_PR_gNB_ID;
+    auto gnbIdLength = m_base->config->gnbIdLength;
+    auto bitsToShift = 32 - gnbIdLength;
+    asn::SetBitString(globalGnbId->gNB_ID.choice.gNB_ID,
+                      octet4{static_cast<uint32_t>(gnbTargetId) << bitsToShift}, static_cast<size_t>(gnbIdLength));
+    asn::SetOctetString3(globalGnbId->pLMNIdentity, ngap_utils::PlmnToOctet3(m_base->config->plmn));
+    targetRanNodeId->globalRANNodeID.choice.globalGNB_ID = globalGnbId;
+
+    asn::SetOctetString3(targetRanNodeId->selectedTAI.pLMNIdentity, ngap_utils::PlmnToOctet3(m_base->config->plmn));
+    asn::SetOctetString3(targetRanNodeId->selectedTAI.tAC, octet3{m_base->config->tac});
+    ieTargetId->value.choice.TargetID.choice.targetRANNodeID = targetRanNodeId;
+    ies.push_back(ieTargetId);
+
+    // PDU Session Resource List.
+    // "All PDU sessions handled by S-RAN (i.e. all existing PDU sessions with active UP
+    // connections) shall be included" - TS 23.502 4.9.1.3.2 step 1.
+    if (!ue->pduSessions.empty())
+    {
+        auto *ieSessionList = asn::New<ASN_NGAP_HandoverRequiredIEs>();
+        ieSessionList->id = ASN_NGAP_ProtocolIE_ID_id_PDUSessionResourceListHORqd;
+        ieSessionList->criticality = ASN_NGAP_Criticality_reject;
+        ieSessionList->value.present = ASN_NGAP_HandoverRequiredIEs__value_PR_PDUSessionResourceListHORqd;
+
+        for (int psi : ue->pduSessions)
+        {
+            auto *sessionItem = asn::New<ASN_NGAP_PDUSessionResourceItemHORqd>();
+            sessionItem->pDUSessionID = static_cast<ASN_NGAP_PDUSessionID_t>(psi);
+            asn::SetOctetString(sessionItem->handoverRequiredTransfer, EncodeHandoverRequiredTransfer());
+            asn::SequenceAdd(ieSessionList->value.choice.PDUSessionResourceListHORqd, sessionItem);
+        }
+        ies.push_back(ieSessionList);
+    }
+
+    // Source To Target Transparent Container
+    auto *ieSourceToTarget = asn::New<ASN_NGAP_HandoverRequiredIEs>();
+    ieSourceToTarget->id = ASN_NGAP_ProtocolIE_ID_id_SourceToTarget_TransparentContainer;
+    ieSourceToTarget->criticality = ASN_NGAP_Criticality_reject;
+    ieSourceToTarget->value.present = ASN_NGAP_HandoverRequiredIEs__value_PR_SourceToTarget_TransparentContainer;
+
+    auto *container = asn::New<ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer>();
+
+    // Simulation payload: carries the UE radio identity so that the target gNB can match the UE
+    ho::SourceInfo sourceInfo{};
+    sourceInfo.ueSti = ue->sti;
+    asn::SetOctetString(container->rRCContainer, ho::EncodeSourceInfo(sourceInfo));
+
+    // Target cell: NR-CGI of the target cell (gNB ID based convention, see NciFromGnbId)
+    container->targetCell_ID.present = ASN_NGAP_NGRAN_CGI_PR_nR_CGI;
+    container->targetCell_ID.choice.nR_CGI = asn::New<ASN_NGAP_NR_CGI>();
+    asn::SetOctetString3(container->targetCell_ID.choice.nR_CGI->pLMNIdentity,
+                         ngap_utils::PlmnToOctet3(m_base->config->plmn));
+    asn::SetBitStringLong<36>(NciFromGnbId(static_cast<uint32_t>(gnbTargetId), gnbIdLength),
+                              container->targetCell_ID.choice.nR_CGI->nRCellIdentity);
+
+    // UE history information: the currently serving cell of this gNB
+    auto *historyItem = asn::New<ASN_NGAP_LastVisitedCellItem>();
+    historyItem->lastVisitedCellInformation.present = ASN_NGAP_LastVisitedCellInformation_PR_nGRANCell;
+    historyItem->lastVisitedCellInformation.choice.nGRANCell =
+        asn::New<ASN_NGAP_LastVisitedNGRANCellInformation>();
+
+    auto *historyNrCgi = asn::New<ASN_NGAP_NR_CGI>();
+    asn::SetOctetString3(historyNrCgi->pLMNIdentity, ngap_utils::PlmnToOctet3(m_base->config->plmn));
+    asn::SetBitStringLong<36>(m_base->config->nci, historyNrCgi->nRCellIdentity);
+    historyItem->lastVisitedCellInformation.choice.nGRANCell->globalCellID.present = ASN_NGAP_NGRAN_CGI_PR_nR_CGI;
+    historyItem->lastVisitedCellInformation.choice.nGRANCell->globalCellID.choice.nR_CGI = historyNrCgi;
+    historyItem->lastVisitedCellInformation.choice.nGRANCell->cellType.cellSize = ASN_NGAP_CellSize_medium;
+    historyItem->lastVisitedCellInformation.choice.nGRANCell->timeUEStayedInCell = 42;
+    ASN_SEQUENCE_ADD(&container->uEHistoryInformation.list, historyItem);
+
+    OctetString encodedContainer = ngap_encode::EncodeS(
+        asn_DEF_ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer, container);
+    if (encodedContainer.length() == 0)
+    {
+        asn::Free(asn_DEF_ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer, container);
+        m_logger->err("N2 handover: source-to-target transparent container encoding failed");
+        return;
+    }
+    asn::Free(asn_DEF_ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer, container);
+    asn::SetOctetString(ieSourceToTarget->value.choice.SourceToTarget_TransparentContainer, encodedContainer);
+    ies.push_back(ieSourceToTarget);
+
+    auto *pdu = asn::ngap::NewMessagePdu<ASN_NGAP_HandoverRequired>(ies);
+    sendNgapUeAssociated(ueId, pdu);
+
+    m_logger->info("N2 handover: Handover Required sent for UE[%d] towards gNB[id %d]", ueId, gnbTargetId);
+}
+
+void NgapTask::receiveHandoverRequest(int amfId, uint16_t stream, ASN_NGAP_HandoverRequest *msg)
+{
+    m_logger->debug("N2 handover: Handover Request received from AMF[%d]", amfId);
+
+    auto *ieAmfNgapId = asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_AMF_UE_NGAP_ID);
+    if (ieAmfNgapId == nullptr)
+    {
+        m_logger->err("N2 handover: Handover Request without AMF-UE-NGAP-ID, ignoring");
+        return;
+    }
+    auto amfUeNgapId = asn::GetSigned64(ieAmfNgapId->AMF_UE_NGAP_ID);
+
+    // Resolve the simulated UE identity from the source-to-target transparent container
+    uint64_t ueSti = 0;
+    auto *ieSourceToTarget =
+        asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_SourceToTarget_TransparentContainer);
+    if (ieSourceToTarget != nullptr)
+    {
+        auto *container = ngap_encode::Decode<ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer>(
+            asn_DEF_ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer,
+            ieSourceToTarget->SourceToTarget_TransparentContainer);
+        if (container != nullptr)
+        {
+            auto info = ho::DecodeSourceInfo(asn::GetOctetString(container->rRCContainer));
+            if (info.has_value())
+                ueSti = info->ueSti;
+            asn::Free(asn_DEF_ASN_NGAP_SourceNGRANNode_ToTargetNGRANNode_TransparentContainer, container);
+        }
+    }
+    if (ueSti == 0)
+    {
+        m_logger->err("N2 handover: cannot resolve the simulated UE identity, ignoring the Handover Request");
+        return;
+    }
+
+    // Drop a possibly stale pending handover for the same UE (e.g. a repeated handover)
+    cancelPendingHandover(ueSti, "replaced by a new Handover Request");
+
+    // Create a provisional UE context. The final context id (the RLS UE id) is not known until the
+    // UE appears on the target cell, hence a temporary negative id is used until that point.
+    auto provisionalUeId = -(++m_handoverTempIdCounter);
+    auto *ue = new NgapUeContext(provisionalUeId);
+    ue->amfUeNgapId = amfUeNgapId;
+    ue->ranUeNgapId = ++m_ueNgapIdCounter;
+    ue->associatedAmfId = amfId;
+    ue->sti = ueSti;
+    ue->uplinkStream = stream;
+    m_ueCtx[provisionalUeId] = ue;
+
+    auto *ieAmbr = asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_UEAggregateMaximumBitRate);
+    if (ieAmbr != nullptr)
+    {
+        ue->ueAmbr.dlAmbr = asn::GetUnsigned64(ieAmbr->UEAggregateMaximumBitRate.uEAggregateMaximumBitRateDL) / 8ull;
+        ue->ueAmbr.ulAmbr = asn::GetUnsigned64(ieAmbr->UEAggregateMaximumBitRate.uEAggregateMaximumBitRateUL) / 8ull;
+    }
+
+    // PDU session resource allocation
+    std::vector<PduSessionResource *> sessions;
+    std::vector<ASN_NGAP_PDUSessionResourceAdmittedItem *> admittedList;
+    std::vector<ASN_NGAP_PDUSessionResourceFailedToSetupItemHOAck *> failedList;
+    int offeredCount = 0;
+
+    auto *ieSetupList = asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_PDUSessionResourceSetupListHOReq);
+    if (ieSetupList != nullptr)
+    {
+        auto &list = ieSetupList->PDUSessionResourceSetupListHOReq.list;
+        for (int i = 0; i < list.count; i++)
+        {
+            auto &item = list.array[i];
+            offeredCount++;
+
+            auto *transfer = ngap_encode::Decode<ASN_NGAP_PDUSessionResourceSetupRequestTransfer>(
+                asn_DEF_ASN_NGAP_PDUSessionResourceSetupRequestTransfer, item->handoverRequestTransfer);
+            if (transfer == nullptr)
+            {
+                m_logger->err("N2 handover: unable to decode a PDU session resource setup request transfer");
+                auto *failedItem =
+                    CreateUnsuccessfulSessionItem(static_cast<int>(item->pDUSessionID),
+                                                  NgapCause::Protocol_transfer_syntax_error, *m_logger);
+                if (failedItem != nullptr)
+                    failedList.push_back(failedItem);
+                continue;
+            }
+
+            auto *resource = new PduSessionResource(provisionalUeId, static_cast<int>(item->pDUSessionID));
+            FillPduSessionResourceFromTransfer(transfer, resource);
+            asn::Free(asn_DEF_ASN_NGAP_PDUSessionResourceSetupRequestTransfer, transfer);
+
+            auto error = ValidateSessionResource(resource);
+            if (error.has_value())
+            {
+                m_logger->err("N2 handover: PDU session[%d] cannot be admitted for UE[%d] (not a supported IPv4 "
+                              "session or missing resource parameters)",
+                              resource->psi, provisionalUeId);
+                auto *failedItem = CreateUnsuccessfulSessionItem(resource->psi, error.value(), *m_logger);
+                if (failedItem != nullptr)
+                    failedList.push_back(failedItem);
+                delete resource;
+                continue;
+            }
+
+            // Allocate this gNB's downlink N3 tunnel endpoint for the session
+            std::string gtpIp = m_base->config->gtpAdvertiseIp.value_or(m_base->config->gtpIp);
+            resource->downTunnel.address = utils::IpToOctetString(gtpIp);
+            resource->downTunnel.teid = ++m_downlinkTeidCounter;
+
+            // Handover Request Acknowledge Transfer: DL N3 TNL information and admitted QoS flows
+            auto *ackTransfer = asn::New<ASN_NGAP_HandoverRequestAcknowledgeTransfer>();
+            auto &dlInfo = ackTransfer->dL_NGU_UP_TNLInformation;
+            dlInfo.present = ASN_NGAP_UPTransportLayerInformation_PR_gTPTunnel;
+            dlInfo.choice.gTPTunnel = asn::New<ASN_NGAP_GTPTunnel>();
+            asn::SetBitString(dlInfo.choice.gTPTunnel->transportLayerAddress, resource->downTunnel.address);
+            asn::SetOctetString4(dlInfo.choice.gTPTunnel->gTP_TEID, (octet4)resource->downTunnel.teid);
+
+            auto &qosList = resource->qosFlows->list;
+            for (int q = 0; q < qosList.count; q++)
+            {
+                auto *qosItem = asn::New<ASN_NGAP_QosFlowItemWithDataForwarding>();
+                qosItem->qosFlowIdentifier = qosList.array[q]->qosFlowIdentifier;
+                ASN_SEQUENCE_ADD(&ackTransfer->qosFlowSetupResponseList.list, qosItem);
+            }
+
+            OctetString encodedAckTransfer =
+                ngap_encode::EncodeS(asn_DEF_ASN_NGAP_HandoverRequestAcknowledgeTransfer, ackTransfer);
+            if (encodedAckTransfer.length() == 0)
+            {
+                m_logger->err("N2 handover: HandoverRequestAcknowledgeTransfer encoding failed");
+                asn::Free(asn_DEF_ASN_NGAP_HandoverRequestAcknowledgeTransfer, ackTransfer);
+                auto *failedItem = CreateUnsuccessfulSessionItem(resource->psi, NgapCause::Protocol_unspecified, *m_logger);
+                if (failedItem != nullptr)
+                    failedList.push_back(failedItem);
+                delete resource;
+                continue;
+            }
+            asn::Free(asn_DEF_ASN_NGAP_HandoverRequestAcknowledgeTransfer, ackTransfer);
+
+            auto *admittedItem = asn::New<ASN_NGAP_PDUSessionResourceAdmittedItem>();
+            admittedItem->pDUSessionID = static_cast<ASN_NGAP_PDUSessionID_t>(resource->psi);
+            asn::SetOctetString(admittedItem->handoverRequestAcknowledgeTransfer, encodedAckTransfer);
+            admittedList.push_back(admittedItem);
+            sessions.push_back(resource);
+        }
+    }
+
+    // All requested sessions were rejected: answer with Handover Failure
+    if (offeredCount > 0 && admittedList.empty())
+    {
+        m_logger->err("N2 handover: all PDU sessions were rejected, sending Handover Failure");
+
+        for (auto *failedItem : failedList)
+            asn::Free(asn_DEF_ASN_NGAP_PDUSessionResourceFailedToSetupItemHOAck, failedItem);
+
+        std::vector<ASN_NGAP_HandoverFailureIEs *> failureIes;
+        auto *ieCause = asn::New<ASN_NGAP_HandoverFailureIEs>();
+        ieCause->id = ASN_NGAP_ProtocolIE_ID_id_Cause;
+        ieCause->criticality = ASN_NGAP_Criticality_ignore;
+        ieCause->value.present = ASN_NGAP_HandoverFailureIEs__value_PR_Cause;
+        ngap_utils::ToCauseAsn_Ref(NgapCause::RadioNetwork_no_radio_resources_available_in_target_cell,
+                                   ieCause->value.choice.Cause);
+        failureIes.push_back(ieCause);
+
+        sendNgapUeAssociated(provisionalUeId, asn::ngap::NewMessagePdu<ASN_NGAP_HandoverFailure>(failureIes));
+        deleteUeContext(provisionalUeId);
+        return;
+    }
+
+    // Build the Handover Request Acknowledge
+    std::vector<ASN_NGAP_HandoverRequestAcknowledgeIEs *> responseIes;
+
+    if (!admittedList.empty())
+    {
+        auto *ie = asn::New<ASN_NGAP_HandoverRequestAcknowledgeIEs>();
+        ie->id = ASN_NGAP_ProtocolIE_ID_id_PDUSessionResourceAdmittedList;
+        ie->criticality = ASN_NGAP_Criticality_ignore;
+        ie->value.present = ASN_NGAP_HandoverRequestAcknowledgeIEs__value_PR_PDUSessionResourceAdmittedList;
+        for (auto *item : admittedList)
+            asn::SequenceAdd(ie->value.choice.PDUSessionResourceAdmittedList, item);
+        responseIes.push_back(ie);
+    }
+
+    if (!failedList.empty())
+    {
+        auto *ie = asn::New<ASN_NGAP_HandoverRequestAcknowledgeIEs>();
+        ie->id = ASN_NGAP_ProtocolIE_ID_id_PDUSessionResourceFailedToSetupListHOAck;
+        ie->criticality = ASN_NGAP_Criticality_ignore;
+        ie->value.present = ASN_NGAP_HandoverRequestAcknowledgeIEs__value_PR_PDUSessionResourceFailedToSetupListHOAck;
+        for (auto *item : failedList)
+            asn::SequenceAdd(ie->value.choice.PDUSessionResourceFailedToSetupListHOAck, item);
+        responseIes.push_back(ie);
+    }
+
+    // Target To Source Transparent Container (carries the simulated handover command)
+    auto *ieTargetToSource = asn::New<ASN_NGAP_HandoverRequestAcknowledgeIEs>();
+    ieTargetToSource->id = ASN_NGAP_ProtocolIE_ID_id_TargetToSource_TransparentContainer;
+    ieTargetToSource->criticality = ASN_NGAP_Criticality_reject;
+    ieTargetToSource->value.present =
+        ASN_NGAP_HandoverRequestAcknowledgeIEs__value_PR_TargetToSource_TransparentContainer;
+
+    ho::CommandInfo commandInfo{};
+    commandInfo.targetNci = static_cast<uint64_t>(m_base->config->nci);
+
+    auto *targetToSourceContainer = asn::New<ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer>();
+    asn::SetOctetString(targetToSourceContainer->rRCContainer, ho::EncodeCommandInfo(commandInfo));
+    OctetString encodedTargetToSource = ngap_encode::EncodeS(
+        asn_DEF_ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer, targetToSourceContainer);
+    if (encodedTargetToSource.length() == 0)
+    {
+        asn::Free(asn_DEF_ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer, targetToSourceContainer);
+        m_logger->err("N2 handover: target-to-source transparent container encoding failed");
+        for (auto *session : sessions)
+            delete session;
+        deleteUeContext(provisionalUeId);
+        return;
+    }
+    asn::Free(asn_DEF_ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer, targetToSourceContainer);
+    asn::SetOctetString(ieTargetToSource->value.choice.TargetToSource_TransparentContainer, encodedTargetToSource);
+    responseIes.push_back(ieTargetToSource);
+
+    // Remember the prepared handover until the UE appears on the target cell
+    auto *pending = new PendingHandover();
+    pending->sti = ueSti;
+    pending->provisionalUeId = provisionalUeId;
+    pending->amfCtxId = amfId;
+    pending->amfUeNgapId = amfUeNgapId;
+    pending->ranUeNgapId = ue->ranUeNgapId;
+    pending->ueAmbr = ue->ueAmbr;
+    pending->sessions = std::move(sessions);
+    pending->createdTime = utils::CurrentTimeMillis();
+    m_pendingHandovers[ueSti] = pending;
+
+    m_logger->info("N2 handover: Handover Request accepted for UE(sti[%llu]), %d session(s) admitted, %d rejected",
+                   (unsigned long long)ueSti, static_cast<int>(admittedList.size()), static_cast<int>(failedList.size()));
+
+    sendNgapUeAssociated(provisionalUeId,
+                         asn::ngap::NewMessagePdu<ASN_NGAP_HandoverRequestAcknowledge>(responseIes));
+}
+
+void NgapTask::receiveHandoverCommand(int amfId, ASN_NGAP_HandoverCommand *msg)
+{
+    m_logger->debug("N2 handover: Handover Command received from AMF[%d]", amfId);
+
+    auto idPair = ngap_utils::FindNgapIdPair(msg);
+
+    // Tolerant lookup: some AMF implementations (e.g. free5GC) may change the AMF-UE-NGAP-ID during
+    // the handover procedure, which is not expected by TS 38.413. The RAN UE NGAP ID is stable, so
+    // the UE is looked up by that id and a changed AMF id is adopted with a warning.
+    NgapUeContext *ue = nullptr;
+    if (idPair.ranUeNgapId.has_value())
+        ue = findUeByRanId(idPair.ranUeNgapId.value());
+    if (ue == nullptr && idPair.amfUeNgapId.has_value())
+        ue = findUeByAmfId(idPair.amfUeNgapId.value());
+    if (ue == nullptr)
+    {
+        m_logger->err("N2 handover: UE context not found for the Handover Command");
+        return;
+    }
+    if (idPair.amfUeNgapId.has_value() && ue->amfUeNgapId != idPair.amfUeNgapId.value())
+    {
+        m_logger->warn("N2 handover: AMF-UE-NGAP-ID changed from %ld to %ld during the handover, adopting the new id",
+                       ue->amfUeNgapId, idPair.amfUeNgapId.value());
+        ue->amfUeNgapId = idPair.amfUeNgapId.value();
+    }
+
+    // Extract the RRC container (the simulated handover command) from the target-to-source container
+    auto *ieContainer = asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_TargetToSource_TransparentContainer);
+    if (ieContainer == nullptr)
+    {
+        m_logger->err("N2 handover: Handover Command without a target-to-source transparent container");
+        return;
+    }
+
+    OctetString rrcContainer;
+    {
+        auto *container = ngap_encode::Decode<ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer>(
+            asn_DEF_ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer,
+            ieContainer->TargetToSource_TransparentContainer);
+        if (container != nullptr)
+        {
+            rrcContainer = asn::GetOctetString(container->rRCContainer);
+            asn::Free(asn_DEF_ASN_NGAP_TargetNGRANNode_ToSourceNGRANNode_TransparentContainer, container);
+        }
+    }
+    if (rrcContainer.length() == 0)
+    {
+        m_logger->err("N2 handover: cannot extract the handover command payload");
+        return;
+    }
+
+    auto w = std::make_unique<NmGnbNgapToRrc>(NmGnbNgapToRrc::HANDOVER);
+    w->ueId = ue->ctxId;
+    w->rrcContainer = std::move(rrcContainer);
+    m_base->rrcTask->push(std::move(w));
+
+    m_logger->info("N2 handover: Handover Command received, forwarding the handover command to UE[%d]", ue->ctxId);
+}
+
+void NgapTask::handleHandoverConfirm(int ueId, uint64_t sti)
+{
+    auto it = m_pendingHandovers.find(sti);
+    if (it == m_pendingHandovers.end())
+    {
+        m_logger->warn("N2 handover: handover confirm from UE[%d] (sti[%llu]) without a matching pending handover", ueId,
+                       (unsigned long long)sti);
+        return;
+    }
+    auto *pending = it->second;
+
+    m_logger->info("N2 handover: UE[%d] appeared on the target cell (sti[%llu])", ueId, (unsigned long long)sti);
+
+    // Release a possibly stale context that occupies the same UE id (e.g. handover back to this node)
+    if (m_ueCtx.count(ueId) != 0)
+    {
+        auto wRelease = std::make_unique<NmGnbNgapToGtp>(NmGnbNgapToGtp::UE_CONTEXT_RELEASE);
+        wRelease->ueId = ueId;
+        m_base->gtpTask->push(std::move(wRelease));
+        deleteUeContext(ueId);
+    }
+
+    // Drop the provisional context; the final context reuses the RAN UE NGAP ID that was
+    // already advertised to the AMF in the Handover Request Acknowledge.
+    deleteUeContext(pending->provisionalUeId);
+
+    auto *ue = new NgapUeContext(ueId);
+    ue->amfUeNgapId = pending->amfUeNgapId;
+    ue->ranUeNgapId = pending->ranUeNgapId;
+    ue->associatedAmfId = pending->amfCtxId;
+    ue->ueAmbr = pending->ueAmbr;
+    ue->sti = sti;
+    m_ueCtx[ueId] = ue;
+
+    // Materialize the prepared PDU sessions in the GTP layer
+    auto wCtx = std::make_unique<NmGnbNgapToGtp>(NmGnbNgapToGtp::UE_CONTEXT_UPDATE);
+    wCtx->update = std::make_unique<GtpUeContextUpdate>(true, ueId, ue->ueAmbr);
+    m_base->gtpTask->push(std::move(wCtx));
+
+    for (auto *prepared : pending->sessions)
+    {
+        auto *resource = new PduSessionResource(ueId, prepared->psi);
+        resource->sessionAmbr = prepared->sessionAmbr;
+        resource->dataForwardingNotPossible = prepared->dataForwardingNotPossible;
+        resource->sessionType = prepared->sessionType;
+        resource->upTunnel = std::move(prepared->upTunnel);
+        resource->downTunnel = std::move(prepared->downTunnel);
+        resource->qosFlows = std::move(prepared->qosFlows);
+        delete prepared;
+
+        auto wSession = std::make_unique<NmGnbNgapToGtp>(NmGnbNgapToGtp::SESSION_CREATE);
+        wSession->resource = resource;
+        m_base->gtpTask->push(std::move(wSession));
+
+        ue->pduSessions.insert(resource->psi);
+    }
+
+    delete pending;
+    m_pendingHandovers.erase(it);
+
+    sendHandoverNotify(ueId);
+}
+
+void NgapTask::sendHandoverNotify(int ueId)
+{
+    auto *ue = findUeContext(ueId);
+    if (ue == nullptr)
+        return;
+
+    std::vector<ASN_NGAP_HandoverNotifyIEs *> ies;
+    auto *pdu = asn::ngap::NewMessagePdu<ASN_NGAP_HandoverNotify>(ies);
+    sendNgapUeAssociated(ueId, pdu);
+
+    m_logger->info("N2 handover: Handover Notify sent for UE[%d]", ueId);
+}
+
+void NgapTask::receiveHandoverPreparationFailure(ASN_NGAP_HandoverPreparationFailure *msg)
+{
+    auto *ie = asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_Cause);
+    if (ie != nullptr)
+        m_logger->err("N2 handover: handover preparation failure, cause[%s]",
+                      ngap_utils::CauseToString(ie->Cause).c_str());
+    else
+        m_logger->err("N2 handover: handover preparation failure");
+}
+
+void NgapTask::cancelPendingHandover(uint64_t ueSti, const char *reason)
+{
+    auto it = m_pendingHandovers.find(ueSti);
+    if (it == m_pendingHandovers.end())
+        return;
+
+    auto *pending = it->second;
+    m_logger->warn("N2 handover: cancelling pending handover for sti[%llu] (%s)", (unsigned long long)ueSti, reason);
+
+    deleteUeContext(pending->provisionalUeId);
+    for (auto *session : pending->sessions)
+        delete session;
+    delete pending;
+    m_pendingHandovers.erase(it);
+}
+
+void NgapTask::cleanupPendingHandovers()
+{
+    int64_t current = utils::CurrentTimeMillis();
+
+    std::vector<uint64_t> expired;
+    for (auto &item : m_pendingHandovers)
+    {
+        if (current - item.second->createdTime > 60'000)
+            expired.push_back(item.first);
+    }
+
+    for (auto sti : expired)
+        cancelPendingHandover(sti, "timed out while waiting for the UE on the target cell");
+}
+
+} // namespace nr::gnb
