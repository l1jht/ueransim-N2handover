@@ -0,0 +1,18 @@
+# N2 handover unit tests (self-contained, no external test framework).
+#
+# The test lives in its own subdirectory so that this delivery can coexist with other test
+# suites (e.g. the IMS delivery) that also extend the tests/ directory.
+
+add_executable(ho-tests
+  ho_tests.cpp
+  ../../src/lib/ho/ho.cpp
+  ../../src/lib/ho/events.cpp
+  ../../src/gnb/gtp/forwarding.cpp
+  ../../src/utils/octet_string.cpp
+  ../../src/utils/common.cpp
+)
+
+target_include_directories(ho-tests PRIVATE ../../src)
+target_compile_options(ho-tests PRIVATE -Wall -Wextra)
+
+add_test(NAME ho-tests COMMAND ho-tests)
diff --git a/tests/handover/ho_tests.cpp b/tests/handover/ho_tests.cpp
new file mode 100644
index 0000000..e24889c
--- /dev/null
+++ b/tests/handover/ho_tests.cpp
@@ -0,0 +1,179 @@
+// Plain-assert unit tests for the N2 handover pure functions.
+//
+// Covers the simulation container codec (lib/ho) and the deterministic cell ranking used by
+// cell selection. No external test framework is used.
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <gnb/gtp/forwarding.hpp>
+#include <lib/ho/events.hpp>
+#include <lib/ho/ho.hpp>
+
+static int g_failures = 0;
+
+#define CHECK(cond, name)                                                                                              \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(cond))                                                                                                   \
+        {                                                                                                              \
+            std::printf("[FAIL] %s\n", name);                                                                          \
+            g_failures++;                                                                                              \
+        }                                                                                                              \
+        else                                                                                                           \
+        {                                                                                                              \
+            std::printf("[ OK ] %s\n", name);                                                                          \
+        }                                                                                                              \
+    } while (0)
+
+int main()
+{
+    using namespace ho;
+
+    // ---------- SourceInfo codec ----------
+    {
+        SourceInfo info{};
+        info.ueSti = 0x1122334455667788ULL;
+        info.hoId = 0xAABBCCDD00112233ULL;
+        auto encoded = EncodeSourceInfo(info);
+        CHECK(encoded.length() == 17, "source info encoded length is 17");
+
+        auto decoded = DecodeSourceInfo(encoded);
+        CHECK(decoded.has_value() && decoded->ueSti == info.ueSti && decoded->hoId == info.hoId,
+              "source info round trip (sti + ho id)");
+    }
+    {
+        OctetString wrongMarker;
+        wrongMarker.appendOctet(MARKER_COMMAND_INFO);
+        wrongMarker.appendOctet8(uint64_t{1});
+        wrongMarker.appendOctet8(uint64_t{1});
+        CHECK(!DecodeSourceInfo(wrongMarker).has_value(), "source info rejects wrong marker");
+
+        OctetString truncated;
+        truncated.appendOctet(MARKER_SOURCE_INFO);
+        CHECK(!DecodeSourceInfo(truncated).has_value(), "source info rejects truncated input");
+
+        CHECK(!DecodeSourceInfo(OctetString{}).has_value(), "source info rejects empty input");
+    }
+
+    // ---------- CommandInfo codec ----------
+    {
+        const uint64_t ncis[] = {0ULL, 1ULL, 0x10ULL, 0xABCDEF123ULL, 0xFFFFFFFFFULL};
+        bool allOk = true;
+        for (uint64_t nci : ncis)
+        {
+            CommandInfo info{};
+            info.targetNci = nci;
+            auto encoded = EncodeCommandInfo(info);
+            auto decoded = DecodeCommandInfo(encoded);
+            allOk = allOk && decoded.has_value() && decoded->targetNci == nci;
+        }
+        CHECK(allOk, "command info round trip for boundary NCIs");
+    }
+    {
+        CommandInfo overflow{};
+        overflow.targetNci = 0x1000000000ULL; // 37 bits
+        CHECK(EncodeCommandInfo(overflow).length() == 0, "command info rejects NCI larger than 36 bits on encode");
+    }
+    {
+        OctetString badRange;
+        badRange.appendOctet(MARKER_COMMAND_INFO);
+        badRange.appendOctet(0x10); // upper 4 bits must be zero for a 36-bit NCI
+        badRange.appendOctet(0);
+        badRange.appendOctet(0);
+        badRange.appendOctet(0);
+        badRange.appendOctet(0);
+        CHECK(!DecodeCommandInfo(badRange).has_value(), "command info enforces the 36-bit NCI range on decode");
+    }
+
+    // ---------- Deterministic cell ranking ----------
+    {
+        CHECK(IsBetterCell(-50, 0x20, -60, 0x10), "stronger signal wins regardless of NCI");
+        CHECK(!IsBetterCell(-60, 0x10, -50, 0x20), "weaker signal loses regardless of NCI");
+        CHECK(IsBetterCell(-50, 0x10, -50, 0x20), "equal signal prefers the lower NCI");
+        CHECK(!IsBetterCell(-50, 0x20, -50, 0x10), "equal signal rejects the higher NCI");
+    }
+
+    // ---------- Target cell resolution ----------
+    {
+        std::vector<std::pair<int, uint64_t>> cells{{1, 0x10}, {2, 0x20}, {3, 0x30}};
+        auto found = FindCellByNci(cells, 0x20);
+        CHECK(found.has_value() && found.value() == 2, "target cell resolved by NCI");
+        CHECK(!FindCellByNci(cells, 0x40).has_value(), "unknown NCI is not resolved");
+    }
+
+    // ---------- Event serialization ----------
+    {
+        HoEvent e{};
+        e.hoId = 42;
+        e.wallMs = 1000;
+        e.monoMs = 123;
+        e.node = "gnb\"x";
+        e.role = EventRole::Source;
+        e.phase = EventPhase::HoRequiredSent;
+        e.ueId = 1;
+        e.sti = 7;
+        e.ranNgapId = 2;
+        e.amfUeNgapId = 3;
+        e.nci = 0x10;
+        e.sessions = {1, 2};
+
+        auto s = SerializeEvent(e);
+        CHECK(s.find("\"schema\":\"ueransim-ho-event/1\"") != std::string::npos, "event schema serialized");
+        CHECK(s.find("\"ho_id\":42") != std::string::npos, "event ho id serialized");
+        CHECK(s.find("\"phase\":\"HO_REQUIRED_SENT\"") != std::string::npos, "event phase serialized");
+        CHECK(s.find("\"role\":\"source\"") != std::string::npos, "event role serialized");
+        CHECK(s.find("\"sessions\":[1,2]") != std::string::npos, "event sessions serialized");
+        CHECK(s.find("gnb\\\"x") != std::string::npos, "event node name escaped");
+    }
+
+    // ---------- Handover data forwarding: bounded buffer ----------
+    {
+        auto make = [](int len, uint8_t fill) {
+            OctetString s;
+            for (int i = 0; i < len; i++)
+                s.appendOctet(fill);
+            return s;
+        };
+
+        nr::gnb::ForwardingBuffer buffer;
+        CHECK(buffer.empty() && buffer.size() == 0 && buffer.bytes() == 0, "forwarding buffer starts empty");
+
+        buffer.push(make(10, 0x01));
+        buffer.push(make(20, 0x02));
+        CHECK(buffer.size() == 2 && buffer.bytes() == 30, "forwarding buffer counts packets and bytes");
+
+        auto first = buffer.pop();
+        CHECK(first.length() == 10 && first.get(0) == 0x01, "forwarding buffer preserves FIFO order");
+        CHECK(buffer.size() == 1 && buffer.bytes() == 20, "forwarding buffer updates counters on pop");
+
+        nr::gnb::ForwardingBuffer limited;
+        for (std::size_t i = 0; i < nr::gnb::ForwardingBuffer::MAX_PACKETS + 5; i++)
+            limited.push(make(1, static_cast<uint8_t>(i)));
+        CHECK(limited.size() == nr::gnb::ForwardingBuffer::MAX_PACKETS && limited.dropped() == 5,
+              "forwarding buffer drops oldest packets beyond the packet limit");
+        CHECK(limited.pop().get(0) == 5, "forwarding buffer keeps the newest packets after a drop");
+
+        nr::gnb::ForwardingBuffer byteLimited;
+        byteLimited.push(make(1024, 0xAA));
+        byteLimited.push(make(static_cast<int>(nr::gnb::ForwardingBuffer::MAX_BYTES), 0xBB));
+        CHECK(byteLimited.size() == 1 && byteLimited.dropped() == 1,
+              "forwarding buffer drops oldest packets beyond the byte limit");
+
+        nr::gnb::ForwardingBuffer emptyBuffer;
+        CHECK(emptyBuffer.pop().length() == 0 && emptyBuffer.dropped() == 0,
+              "forwarding buffer pop on empty is a no-op");
+    }
+
+    if (g_failures == 0)
+    {
+        std::printf("All N2 handover tests passed.\n");
+        return 0;
+    }
+
+    std::printf("%d N2 handover test(s) failed.\n", g_failures);
+    return 1;
+}
