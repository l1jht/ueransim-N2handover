+
+namespace nr::gnb
+{
+
+void ForwardingBuffer::push(OctetString &&pdu)
+{
+    m_bytes += static_cast<std::size_t>(pdu.length());
+    m_packets.emplace_back(std::move(pdu));
+
+    while (!m_packets.empty() && (m_packets.size() > MAX_PACKETS || m_bytes > MAX_BYTES))
+        dropOldest();
+}
+
+OctetString ForwardingBuffer::pop()
+{
+    if (m_packets.empty())
+        return OctetString{};
+
+    OctetString pdu = std::move(m_packets.front());
+    m_packets.pop_front();
+    m_bytes -= static_cast<std::size_t>(pdu.length());
+    return pdu;
+}
+
+void ForwardingBuffer::dropOldest()
+{
+    if (m_packets.empty())
+        return;
+
+    m_bytes -= static_cast<std::size_t>(m_packets.front().length());
+    m_packets.pop_front();
+    m_dropped++;
+}
+
+} // namespace nr::gnb
