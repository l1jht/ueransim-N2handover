+// The target NCI is derived from the target gNB ID using the same convention as the NG Setup
+// (36-bit NCI = gNB ID (idLength bits) followed by the cell ID part, which is 0 in this simulation).
+static uint64_t NciFromGnbId(uint32_t gnbId, int idLength)
+{
+    if (idLength < 22 || idLength > 32)
+        return 0;
+    return static_cast<uint64_t>(gnbId) << (36 - idLength);
+}
+
+static std::vector<int> SessionsOf(const NgapUeContext *ue)
+{
+    if (ue == nullptr)
+        return {};
+    return std::vector<int>(ue->pduSessions.begin(), ue->pduSessions.end());
+}
+
+static ho::HoEvent MakeEvent(ho::EventRole role, ho::EventPhase phase, uint64_t hoId, const NgapUeContext *ue,
+                             int64_t nci, std::vector<int> sessions)
+{
+    ho::HoEvent event{};
+    event.hoId = hoId;
+    event.role = role;
+    event.phase = phase;
+    event.nci = nci;
+    if (ue != nullptr)
+    {
+        event.ueId = ue->ctxId;
+        event.sti = ue->sti;
+        event.ranNgapId = ue->ranUeNgapId;
+        event.amfUeNgapId = ue->amfUeNgapId;
+    }
+    event.sessions = std::move(sessions);
+    return event;
+}
+
+static OctetString EncodeHandoverRequiredTransfer()
+{
+    auto *transfer = asn::New<ASN_NGAP_HandoverRequiredTransfer>();
+    // The source indicates that the direct forwarding path is available (TS 23.502 4.9.1.3.2 step 1).
+    // In this simulation both gNBs are always IP reachable from each other, therefore direct
+    // forwarding is considered available. The core network decides whether to use direct or indirect
+    // forwarding (the gNB side supports both, see the delivery documentation).
+    transfer->directForwardingPathAvailability = asn::New<ASN_NGAP_DirectForwardingPathAvailability_t>();
+    *transfer->directForwardingPathAvailability = ASN_NGAP_DirectForwardingPathAvailability_direct_path_available;
+    OctetString encoded = ngap_encode::EncodeS(asn_DEF_ASN_NGAP_HandoverRequiredTransfer, transfer);
+    asn::Free(asn_DEF_ASN_NGAP_HandoverRequiredTransfer, transfer);
+    return encoded;
+}
+
+static void FillPduSessionResourceFromTransfer(ASN_NGAP_PDUSessionResourceSetupRequestTransfer *transfer,
+                                               PduSessionResource *resource)
+{
+    auto *ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_PDUSessionAggregateMaximumBitRate);
+    if (ie != nullptr)
+    {
+        resource->sessionAmbr.dlAmbr =
+            asn::GetUnsigned64(ie->PDUSessionAggregateMaximumBitRate.pDUSessionAggregateMaximumBitRateDL) / 8ull;
+        resource->sessionAmbr.ulAmbr =
+            asn::GetUnsigned64(ie->PDUSessionAggregateMaximumBitRate.pDUSessionAggregateMaximumBitRateUL) / 8ull;
+    }
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_DataForwardingNotPossible);
+    if (ie != nullptr)
+        resource->dataForwardingNotPossible = true;
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_PDUSessionType);
+    if (ie != nullptr)
+        resource->sessionType = ngap_utils::PduSessionTypeFromAsn(ie->PDUSessionType);
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_UL_NGU_UP_TNLInformation);
+    if (ie != nullptr)
+    {
+        resource->upTunnel.teid = (uint32_t)asn::GetOctet4(ie->UPTransportLayerInformation.choice.gTPTunnel->gTP_TEID);
+        resource->upTunnel.address = asn::GetOctetString(ie->UPTransportLayerInformation.choice.gTPTunnel->transportLayerAddress);
+    }
+
+    ie = asn::ngap::GetProtocolIe(transfer, ASN_NGAP_ProtocolIE_ID_id_QosFlowSetupRequestList);
+    if (ie != nullptr)
+    {
+        auto *ptr = asn::New<ASN_NGAP_QosFlowSetupRequestList>();
+        asn::DeepCopy(asn_DEF_ASN_NGAP_QosFlowSetupRequestList, ie->QosFlowSetupRequestList, ptr);
+        resource->qosFlows = asn::WrapUnique(ptr, asn_DEF_ASN_NGAP_QosFlowSetupRequestList);
+    }
+}
+
+static std::optional<NgapCause> ValidateSessionResource(const PduSessionResource *resource)
+{
+    if (resource->sessionType != PduSessionType::IPv4)
+        return NgapCause::RadioNetwork_unspecified;
+
+    if (resource->upTunnel.address.length() == 0)
+        return NgapCause::Protocol_transfer_syntax_error;
+
+    if (resource->qosFlows == nullptr || resource->qosFlows->list.count == 0)
+        return NgapCause::Protocol_semantic_error;
+
+    return std::nullopt;
+}
+
+static ASN_NGAP_PDUSessionResourceFailedToSetupItemHOAck *CreateUnsuccessfulSessionItem(int psi, NgapCause cause,
+                                                                                        Logger &logger)
+{
+    auto *tr = asn::New<ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer>();
+    ngap_utils::ToCauseAsn_Ref(cause, tr->cause);
+
+    OctetString encodedTr =
+        ngap_encode::EncodeS(asn_DEF_ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer, tr);
+    if (encodedTr.length() == 0)
+    {
+        asn::Free(asn_DEF_ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer, tr);
+        logger.err("HandoverResourceAllocationUnsuccessfulTransfer encoding failed");
+        return nullptr;
+    }
+    asn::Free(asn_DEF_ASN_NGAP_HandoverResourceAllocationUnsuccessfulTransfer, tr);
+
+    auto *item = asn::New<ASN_NGAP_PDUSessionResourceFailedToSetupItemHOAck>();
+    item->pDUSessionID = static_cast<ASN_NGAP_PDUSessionID_t>(psi);
+    asn::SetOctetString(item->handoverResourceAllocationUnsuccessfulTransfer, encodedTr);
+    return item;
+}
