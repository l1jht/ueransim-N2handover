+void NasMm::handleRrcHandoverCommand(const Tai &previousTai)
+{
+    if (m_mmState == EMmState::MM_NULL)
+        return;
+
+    auto currentCell = m_base->shCtx.currentCell.get();
+    if (!currentCell.hasValue())
+    {
+        m_logger->err("N2 handover: handover completed without a serving cell");
+        return;
+    }
+
+    Tai currentTai{currentCell.plmn, currentCell.tac};
+    if (currentTai == previousTai)
+    {
+        m_logger->debug("N2 handover: tracking area unchanged, no mobility registration update required");
+        return;
+    }
+
+    // TS 23.502 4.9.1.3.3 step 12: after the handover the UE performs a mobility registration
+    // update (a subset of the registration procedure) when the tracking area has changed.
+    if (m_mmState == EMmState::MM_REGISTERED && currentCell.category == ECellCategory::SUITABLE_CELL)
+    {
+        m_logger->info("N2 handover: tracking area changed after the handover, initiating a mobility registration "
+                       "update");
+        mobilityUpdatingRequired(ERegUpdateCause::ENTER_UNLISTED_TRACKING_AREA);
+    }
+}
