+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+#include <utils/octet_string.hpp>
+
+namespace nr::gnb
+{
+
+// Bounded FIFO buffer that holds user plane payloads forwarded to the target gNB before the UE
+// arrives on the target cell (N2 handover data forwarding, see the delivery documentation).
+//
+// The class is intentionally free of task dependencies so that the buffering policy (ordering,
+// limits, drop-oldest) can be unit tested.
+class ForwardingBuffer
+{
+  public:
+    // Bounds protect the target node from unbounded memory usage. The expected occupancy is the
+    // amount of data forwarded during the (sub-second) handover window.
+    static constexpr std::size_t MAX_PACKETS = 256;
+    static constexpr std::size_t MAX_BYTES = 1024 * 1024;
+
+    // Appends a payload. If a limit is exceeded, the oldest payload is dropped.
+    void push(OctetString &&pdu);
+
+    // Removes and returns the oldest payload. The result is empty if the buffer is empty.
+    OctetString pop();
+
+    bool empty() const
+    {
+        return m_packets.empty();
+    }
+
+    std::size_t size() const
+    {
+        return m_packets.size();
+    }
+
+    std::size_t bytes() const
+    {
+        return m_bytes;
+    }
+
+    // Number of payloads dropped because of the limits above.
+    std::uint64_t dropped() const
+    {
+        return m_dropped;
+    }
+
+  private:
+    void dropOldest();
+
+    std::deque<OctetString> m_packets{};
+    std::size_t m_bytes{};
+    std::uint64_t m_dropped{};
+};
+
+} // namespace nr::gnb
