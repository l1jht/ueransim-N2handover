+//
+// This file is a part of UERANSIM project.
+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+// UE side RRC handling of the N2 handover simulation.
+//
+// The handover command arrives inside an RRC Reconfiguration message (the payload is generated by
+// the target gNB and transported transparently over NGAP). The UE resolves the target cell by its
+// NCI, assigns it as the serving cell and confirms the reconfiguration to the target gNB.
+
+#include "task.hpp"
+
+#include <algorithm>
+
+#include <lib/ho/ho.hpp>
+#include <lib/rrc/encode.hpp>
+#include <ue/nas/task.hpp>
+#include <ue/rls/task.hpp>
+
+#include <asn/rrc/ASN_RRC_RRCReconfiguration-IEs.h>
+#include <asn/rrc/ASN_RRC_RRCReconfiguration.h>
+#include <asn/rrc/ASN_RRC_RRCReconfigurationComplete-IEs.h>
+#include <asn/rrc/ASN_RRC_RRCReconfigurationComplete.h>
+#include <asn/rrc/ASN_RRC_UL-DCCH-Message.h>
+
+namespace nr::ue
+{
+
+bool UeRrcTask::isSuitableCell(const UeCellDesc &cell)
+{
+    Plmn selectedPlmn = m_base->shCtx.selectedPlmn.get();
+    Tai tai{cell.sib1.plmn, cell.sib1.tac};
+
+    if (!cell.sib1.hasSib1 || !cell.mib.hasMib || cell.sib1.plmn != selectedPlmn || cell.mib.isBarred ||
+        cell.sib1.isReserved)
+        return false;
+
+    if (m_base->shCtx.forbiddenTaiRoaming.get<bool>([&tai](auto &item) {
+            return std::any_of(item.begin(), item.end(), [&tai](auto &element) { return element == tai; });
+        }))
+        return false;
+
+    if (m_base->shCtx.forbiddenTaiRps.get<bool>([&tai](auto &item) {
+            return std::any_of(item.begin(), item.end(), [&tai](auto &element) { return element == tai; });
+        }))
+        return false;
+
+    return true;
+}
+
+bool UeRrcTask::isAcceptableCell(const UeCellDesc &cell)
+{
+    Tai tai{cell.sib1.plmn, cell.sib1.tac};
+
+    if (!cell.sib1.hasSib1 || !cell.mib.hasMib || cell.mib.isBarred || cell.sib1.isReserved)
+        return false;
+
+    if (m_base->shCtx.forbiddenTaiRoaming.get<bool>([&tai](auto &item) {
+            return std::any_of(item.begin(), item.end(), [&tai](auto &element) { return element == tai; });
+        }))
+        return false;
+
+    if (m_base->shCtx.forbiddenTaiRps.get<bool>([&tai](auto &item) {
+            return std::any_of(item.begin(), item.end(), [&tai](auto &element) { return element == tai; });
+        }))
+        return false;
+
+    return true;
+}
+
+void UeRrcTask::receiveRrcReconfiguration(const ASN_RRC_RRCReconfiguration &msg)
+{
+    m_logger->debug("RRC Reconfiguration received");
+
+    if (msg.criticalExtensions.present != ASN_RRC_RRCReconfiguration__criticalExtensions_PR_rrcReconfiguration)
+        return;
+
+    auto *ies = msg.criticalExtensions.choice.rrcReconfiguration;
+    if (ies == nullptr || ies->secondaryCellGroup == nullptr)
+    {
+        m_logger->err("N2 handover: RRC Reconfiguration without a handover command payload, ignoring");
+        return;
+    }
+
+    auto command = ho::DecodeCommandInfo(asn::GetOctetString(*ies->secondaryCellGroup));
+    if (!command.has_value())
+    {
+        m_logger->err("N2 handover: invalid handover command payload, ignoring");
+        return;
+    }
+
+    // Resolve the target cell among the cells in coverage (the NCI is learned from SIB1)
+    std::vector<std::pair<int, uint64_t>> cells;
+    for (auto &item : m_cellDesc)
+        if (item.second.sib1.hasSib1)
+            cells.emplace_back(item.first, static_cast<uint64_t>(item.second.sib1.nci));
+
+    auto targetCellId = ho::FindCellByNci(cells, command->targetNci);
+    if (!targetCellId.has_value())
+    {
+        m_logger->err("N2 handover: target cell (nci[%llu]) is not in coverage, cannot perform the handover",
+                      (unsigned long long)command->targetNci);
+        return;
+    }
+
+    Tai previousTai;
+    {
+        auto previousCell = m_base->shCtx.currentCell.get();
+        previousTai = Tai{previousCell.plmn, previousCell.tac};
+    }
+
+    m_lastTid = msg.rrc_TransactionIdentifier;
+
+    if (!performCellChange(targetCellId.value()))
+        return;
+
+    // TS 38.331: the UE confirms the reconfiguration to the target cell
+    sendHandoverConfirmMessage();
+
+    // TS 23.502 4.9.1.3.3 step 12: the UE performs a mobility registration update if needed
+    auto w = std::make_unique<NmUeRrcToNas>(NmUeRrcToNas::RRC_HANDOVER_COMMAND);
+    w->previousTai = previousTai;
+    m_base->nasTask->push(std::move(w));
+}
+
+bool UeRrcTask::performCellChange(int newCellId)
+{
+    auto previousCell = m_base->shCtx.currentCell.get();
+
+    if (newCellId == 0)
+    {
+        m_logger->err("N2 handover: cannot change the serving cell, the new cell id is 0");
+        return false;
+    }
+    if (previousCell.cellId == newCellId)
+    {
+        m_logger->warn("N2 handover: the target cell[%d] is already the serving cell", newCellId);
+        return false;
+    }
+    if (m_cellDesc.count(newCellId) == 0)
+    {
+        m_logger->err("N2 handover: cannot change to cell[%d], no cell description available", newCellId);
+        return false;
+    }
+
+    auto &desc = m_cellDesc[newCellId];
+
+    ActiveCellInfo cellInfo{};
+    cellInfo.cellId = newCellId;
+    cellInfo.plmn = desc.sib1.plmn;
+    cellInfo.tac = desc.sib1.tac;
+
+    if (isSuitableCell(desc))
+        cellInfo.category = ECellCategory::SUITABLE_CELL;
+    else if (isAcceptableCell(desc))
+        cellInfo.category = ECellCategory::ACCEPTABLE_CELL;
+    else
+    {
+        m_logger->err("N2 handover: cannot change to cell[%d], the cell is neither suitable nor acceptable", newCellId);
+        return false;
+    }
+
+    m_base->shCtx.currentCell.set(cellInfo);
+    m_logger->info("N2 handover: serving cell changed from cell[%d] to cell[%d] (plmn[%s] tac[%d])",
+                   previousCell.cellId, newCellId, ToJson(cellInfo.plmn).str().c_str(), cellInfo.tac);
+
+    auto w = std::make_unique<NmUeRrcToRls>(NmUeRrcToRls::ASSIGN_CURRENT_CELL);
+    w->cellId = newCellId;
+    m_base->rlsTask->push(std::move(w));
+
+    return true;
+}
+
+void UeRrcTask::sendHandoverConfirmMessage()
+{
+    auto *pdu = asn::New<ASN_RRC_UL_DCCH_Message>();
+    pdu->message.present = ASN_RRC_UL_DCCH_MessageType_PR_c1;
+    pdu->message.choice.c1 = asn::NewFor(pdu->message.choice.c1);
+    pdu->message.choice.c1->present = ASN_RRC_UL_DCCH_MessageType__c1_PR_rrcReconfigurationComplete;
+
+    auto &complete = pdu->message.choice.c1->choice.rrcReconfigurationComplete =
+        asn::New<ASN_RRC_RRCReconfigurationComplete>();
+    complete->rrc_TransactionIdentifier = m_lastTid;
+    complete->criticalExtensions.present =
+        ASN_RRC_RRCReconfigurationComplete__criticalExtensions_PR_rrcReconfigurationComplete;
+    complete->criticalExtensions.choice.rrcReconfigurationComplete =
+        asn::New<ASN_RRC_RRCReconfigurationComplete_IEs>();
+
+    m_logger->info("N2 handover: sending RRC Reconfiguration Complete to the target cell");
+    sendRrcMessage(pdu);
+    asn::Free(asn_DEF_ASN_RRC_UL_DCCH_Message, pdu);
+}
+
+} // namespace nr::ue
