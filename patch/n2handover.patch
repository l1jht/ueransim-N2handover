+void GtpTask::handleForwardingSetup(NmGnbNgapToGtp &msg)
+{
+    for (auto &session : msg.hoForwardingTeids)
+    {
+        int psi = session.first;
+        uint32_t teid = session.second;
+
+        if (m_sessionTree.findByDownTeid(teid) != 0)
+        {
+            m_logger->err("N2 handover: forwarding TEID[%u] collides with an existing downlink TEID, PSI[%d] skipped",
+                          teid, psi);
+            continue;
+        }
+        if (m_forwardingIncoming.count(teid) != 0)
+            m_logger->warn("N2 handover: forwarding TEID[%u] was already registered, replacing it", teid);
+
+        ForwardingIncoming entry{};
+        entry.sti = msg.hoSti;
+        entry.psi = psi;
+        m_forwardingIncoming[teid] = std::move(entry);
+
+        m_logger->info("N2 handover: DL forwarding endpoint registered for sti[%llu] PSI[%d], TEID[%u]",
+                       (unsigned long long)msg.hoSti, psi, teid);
+    }
+}
+
+void GtpTask::handleForwardingStart(NmGnbNgapToGtp &msg)
+{
+    for (auto &session : msg.hoForwardingTunnels)
+    {
+        ForwardingRedirect redirect{};
+        redirect.tunnel = std::move(session.second);
+
+        m_forwardingRedirects[MakeSessionResInd(msg.ueId, session.first)] = std::move(redirect);
+    }
+
+    if (!msg.hoForwardingTunnels.empty())
+        m_logger->info("N2 handover: data forwarding started for UE[%d], %zu session(s)", msg.ueId,
+                       msg.hoForwardingTunnels.size());
+}
+
+void GtpTask::handleForwardingFlush(NmGnbNgapToGtp &msg)
+{
+    for (auto &item : m_forwardingIncoming)
+    {
+        auto &entry = item.second;
+        if (entry.sti != msg.hoSti)
+            continue;
+
+        entry.ueId = msg.hoUeId;
+        entry.alias = true;
+
+        uint64_t sessionInd = MakeSessionResInd(entry.ueId, entry.psi);
+        uint64_t flushed = 0;
+        while (!entry.buffer.empty())
+        {
+            deliverDownlink(sessionInd, entry.buffer.pop());
+            flushed++;
+        }
+        entry.delivered += flushed;
+
+        m_logger->info("N2 handover: forwarding data flushed for UE[%d] PSI[%d] (%llu packet(s); %llu received, "
+                       "%llu dropped); the endpoint remains a downlink alias of the session",
+                       entry.ueId, entry.psi, (unsigned long long)flushed, (unsigned long long)entry.received,
+                       (unsigned long long)entry.buffer.dropped());
+    }
+}
+
+void GtpTask::handleForwardingStop(int ueId)
+{
+    uint64_t total = 0;
+    int sessions = 0;
+    for (auto it = m_forwardingRedirects.begin(); it != m_forwardingRedirects.end();)
+    {
+        if (GetUeId(it->first) == ueId)
+        {
+            m_logger->info("N2 handover: data forwarding stopped for UE[%d] PSI[%d] (%llu packet(s) forwarded)", ueId,
+                           GetPsi(it->first), (unsigned long long)it->second.packets);
+            total += it->second.packets;
+            sessions++;
+            it = m_forwardingRedirects.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+
+    if (sessions > 0)
+        m_logger->info("N2 handover: data forwarding stopped for UE[%d], %llu packet(s) in total", ueId,
+                       (unsigned long long)total);
+}
+
+void GtpTask::handleForwardingTeardown(uint64_t sti)
+{
+    for (auto it = m_forwardingIncoming.begin(); it != m_forwardingIncoming.end();)
+    {
+        if (it->second.sti == sti)
+        {
+            m_logger->info("N2 handover: forwarding endpoint released for sti[%llu] PSI[%d] (%llu received, "
+                           "%llu dropped)",
+                           (unsigned long long)sti, it->second.psi, (unsigned long long)it->second.received,
+                           (unsigned long long)it->second.buffer.dropped());
+            it = m_forwardingIncoming.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+}
+
+void GtpTask::forwardToRedirect(ForwardingRedirect &redirect, gtp::GtpMessage &incoming)
+{
+    // Determine the QFI of the forwarded data, if the received packet carried a PDU session
+    // container (TS 38.415).
+    int qfi = -1;
+    for (auto &ext : incoming.extHeaders)
+    {
+        auto *container = dynamic_cast<gtp::PduSessionContainerExtHeader *>(ext.get());
+        if (container == nullptr || container->pduSessionInformation == nullptr)
+            continue;
+
+        if (auto *dl = dynamic_cast<gtp::DlPduSessionInformation *>(container->pduSessionInformation.get()))
+            qfi = dl->qfi;
+        else if (auto *ul = dynamic_cast<gtp::UlPduSessionInformation *>(container->pduSessionInformation.get()))
+            qfi = ul->qfi;
+    }
+
+    gtp::GtpMessage gtp{};
+    gtp.msgType = incoming.msgType; // a G-PDU, or an end marker copied into the forwarding tunnel
+    gtp.teid = redirect.tunnel.teid;
+
+    // The forwarded packet travels towards the UPF (indirect forwarding) or the target gNB (direct
+    // forwarding). The PDU session container carries the QoS flow of the data; in the direction of
+    // this tunnel the uplink variant is used (the core network matches the forwarding rules on it).
+    if (qfi >= 0)
+    {
+        auto pduSessionInfo = std::make_unique<gtp::UlPduSessionInformation>();
+        pduSessionInfo->qfi = qfi;
+
+        auto container = std::make_unique<gtp::PduSessionContainerExtHeader>();
+        container->pduSessionInformation = std::move(pduSessionInfo);
+        gtp.extHeaders.push_back(std::move(container));
+    }
+    gtp.payload = std::move(incoming.payload);
+
+    OctetString gtpPdu;
+    if (!gtp::EncodeGtpMessage(gtp, gtpPdu))
+    {
+        m_logger->err("N2 handover: data forwarding failed, GTP encoding failed");
+        return;
+    }
+
+    m_udpServer->send(InetAddress(redirect.tunnel.address, cons::GtpPort), gtpPdu);
+
+    if (gtp.msgType == gtp::GtpMessage::MT_END_MARKER)
+    {
+        m_logger->info("N2 handover: end marker forwarded to the forwarding TNL");
+        return;
+    }
+
+    redirect.packets++;
+    if (!redirect.firstLogged)
+    {
+        redirect.firstLogged = true;
+        m_logger->info("N2 handover: data forwarding active, first packet sent to the forwarding TNL (QFI[%d])", qfi);
+    }
+}
+
+void GtpTask::deliverDownlink(uint64_t sessionInd, OctetString &&pdu)
+{
+    if (!m_rateLimiter->allowDownlinkPacket(sessionInd, static_cast<uint64_t>(pdu.length())))
+        return;
+
+    auto w = std::make_unique<NmGnbGtpToRls>(NmGnbGtpToRls::DATA_PDU_DELIVERY);
+    w->ueId = GetUeId(sessionInd);
+    w->psi = GetPsi(sessionInd);
+    w->pdu = std::move(pdu);
+    m_base->rlsTask->push(std::move(w));
+}
